    Flags=$00
    FileNameWr=Kachow2.CSV
    VarIdentWr=viGlobInc,viGlobEff,viEArray,viE_Grid,viPR,
    Units=uikW,uiW_m2,uim3_h,uimeterW,
    TypeValW=Hour
    Separator=$002C
    DecimalSep=$002E
    NCarCol=6
    ASCIIFmt=1
    DatesFmt=1
  End of TSimulFich
  SimulPlots=Start
    PVObject_=pvSimulPlot
      Comment=Reference Incident Energy in Collector Plane
      Version=8.0.11
      Flags=$000E
      PlotType=VarNorm
      VarAccP=Day
      VarX=GlobInc
      VarY=EArray
      VarZ=E_Grid
      VarU=EUnused
      UnitX=kWh_m2_d
